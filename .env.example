# Copiez ce fichier en « .env » (ignoré par Git) pour changer les réglages par défaut.

# Garde-fou : nombre maximal de packs ouverts par site et par passage (le stock réel est d environ 10).
MAX_PACKS_PER_RUN=100

# Navigateur piloté : « chrome » (celui installé, recommandé), « msedge », ou vide pour le Chromium de Playwright.
BROWSER_CHANNEL=chrome

# 0 pour voir la fenêtre du navigateur (utile pour comprendre un échec).
HEADLESS=1

# wikitcg.net : identifiant d'une série à ouvrir en priorité (par défaut, celle où il manque le plus de cartes),
# et 0 pour ne pas tenter le pack mystère.
# WIKITCG_NET_SERIES=ancient-civilizations
# WIKITCG_NET_MYSTERY=0

# Dossier des exports de cookies (format Netscape, « <hôte>_cookies.txt ») et dossier d'état.
COOKIES_DIR=Cookies
STATE_DIR=.state
